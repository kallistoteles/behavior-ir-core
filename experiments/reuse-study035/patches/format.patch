+pub fn research035_clock(phase: Research035Phase) -> Research035Clock {
+    if matches!(phase, Research035Phase::Evaluation) {
+        EVALUATION_DEPTH.with(|d| d.set(d.get() + 1));
+    }
+    Research035Clock {
+        start: std::time::Instant::now(),
+        phase,
+        evaluation_before: CLOCKS.with(|c| c.get().evaluation_ns),
+    }
