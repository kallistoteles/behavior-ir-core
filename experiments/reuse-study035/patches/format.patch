+fn nanos(d: std::time::Duration) -> u64 {
+    d.as_nanos().min(u64::MAX as u128) as u64
+}
+impl Drop for Research035Clock {
+    fn drop(&mut self) {
+        let elapsed = nanos(self.start.elapsed());
+        CLOCKS.with(|cell| {
+            let mut c = cell.get();
+            match self.phase {
+                Research035Phase::Evaluation => {
+                    c.evaluation_ns += elapsed;
+                    EVALUATION_DEPTH.with(|d| d.set(d.get() - 1));
+                }
+                Research035Phase::Observation => {
+                    c.observation_ns += elapsed;
+                    if EVALUATION_DEPTH.with(Cell::get) > 0 {
+                        c.evaluation_observation_ns += elapsed;
+                    } else {
+                        c.exterior_observation_ns += elapsed;
+                    }
+                }
+                Research035Phase::Identity => c.identity_ns += elapsed,
+                Research035Phase::Reestablishment => c.reestablishment_ns += elapsed,
+                Research035Phase::AffectedMaintenance => c.affected_maintenance_ns += elapsed,
+                Research035Phase::Envelope => {
+                    let nested = c.evaluation_ns.checked_sub(self.evaluation_before);
+                    if let Some(exclusive) = nested.and_then(|n| elapsed.checked_sub(n)) {
+                        c.observation_ns += exclusive;
+                        c.exterior_observation_ns += exclusive;
+                    } else {
+                        c.invalid_intervals += 1;
+                    }
+                }
+            };
+            cell.set(c);
+        });
+    }
+}
+pub fn research035_child_observation(total: std::time::Duration, logical: std::time::Duration) {
+    CLOCKS.with(|cell| {
+        let mut c = cell.get();
+        if let Some(output) = total.checked_sub(logical) {
+            c.observation_ns += nanos(output);
+            if EVALUATION_DEPTH.with(Cell::get) > 0 {
+                c.evaluation_observation_ns += nanos(output);
+            } else {
+                c.exterior_observation_ns += nanos(output);
+            }
+        } else {
+            c.invalid_intervals += 1;
+        }
+        cell.set(c);
+    });
