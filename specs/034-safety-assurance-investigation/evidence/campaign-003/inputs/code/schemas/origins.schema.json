{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "034 requirement origins and product decisions",
  "type": "object",
  "required": [
    "format",
    "origins"
  ],
  "properties": {
    "format": {
      "const": "core034.origins.v1"
    },
    "origins": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "guarantee",
          "beneficiary",
          "lifecycle",
          "subject",
          "interpretation",
          "justification",
          "scope",
          "classification",
          "original_user_intent",
          "premises",
          "context_refs",
          "decision_dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "deployment_enforcement",
              "finality",
              "history_correctness",
              "initial_validity",
              "new_recipient_verification",
              "program_certification",
              "replay_restrictions",
              "timing"
            ]
          },
          "guarantee": {
            "type": "string",
            "minLength": 1
          },
          "beneficiary": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "explicit",
              "derived",
              "proposal",
              "unresolved"
            ]
          },
          "original_user_intent": {
            "const": "unestablished"
          },
          "premises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "decision_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "productDecision": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "status",
        "rationale",
        "approval"
      ],
      "properties": {
        "status": {
          "enum": [
            "unresolved",
            "proposed",
            "explicitly_decided"
          ]
        }
      },
      "description": "An explicitly decided product contract additionally requires source-bound reviewed explicit product approval; historical experiment approval is insufficient. Runtime validator enforces this rule."
    }
  }
}
