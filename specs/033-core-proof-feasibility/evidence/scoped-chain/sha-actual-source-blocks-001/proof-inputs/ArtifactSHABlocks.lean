    NativeDenotes actualBytes inputs (SHA256.stateWords (SHA256.compress (SHA256Compiled.expectedState inputs) (SHA256Compiled.expectedBlock inputs))) := by
  have result:=actual_bytes_sound SHAMaterialized.program actualBytes actual_validated inputs
  rw [SHAMaterialized.program_meaning] at result
  exact result
end ArtifactSHABlocks
