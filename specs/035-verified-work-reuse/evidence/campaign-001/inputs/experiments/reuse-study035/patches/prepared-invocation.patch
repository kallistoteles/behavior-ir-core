+/// Research-only fresh integration through the unchanged envelope builder.
+/// The CheckedEvaluation is produced by actual Core execution at a private
+/// complete parent; no serialized decision is accepted as fresh authority.
+#[doc(hidden)]
+pub fn invoke_resolved_research035(
+    module: &Module, resolved: ResolvedInvocation<'_>, facts: &dyn crate::EvaluationFacts,
+    parent: &crate::eval::prepared::PreparedSnapshot,
+) -> Result<(InvocationRecord,crate::eval::Observed,Option<crate::eval::prepared::CheckedEvaluation>),TransportError> {
+    if resolved.kind() != "action" { let (record,observed)=invoke_resolved(module,resolved,facts)?;return Ok((record,observed,None)); }
+    let mut request=resolved_request(&resolved);
+    request["action"]=json!(resolved.requested.capability);
+    let checked=parent.evaluate(module,&request.to_string(),facts);
+    let (record,observed)=invoke_resolved_version(module,resolved,facts,None,
+        Some((checked.record().clone(),checked.observed().clone())))?;
+    Ok((record,observed,Some(checked)))
+}
