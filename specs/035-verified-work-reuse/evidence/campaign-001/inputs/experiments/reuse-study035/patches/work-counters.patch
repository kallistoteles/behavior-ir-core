+/// Original Core tests retain their default active counters. Research timing
+/// mode explicitly disables detailed counting before constructing its samples.
+pub fn research035_enable(enabled:bool){ENABLED.with(|e|e.set(enabled));}
+pub fn research035_scope()->Option<Vec<(String,String)>>{ALLOWED.with(|a|a.borrow().as_ref().map(|s|s.iter().cloned().collect()))}
+
+// Coarse phase clocks are distinct from detailed work counters. They never enter
+// original documents. Nested envelope/evaluation intervals are made exclusive.
+#[derive(Clone,Copy,Debug,Default,serde::Serialize)]
+pub struct Research035Clocks {
+ pub evaluation_ns:u64,pub observation_ns:u64,pub identity_ns:u64,
+ pub reestablishment_ns:u64,pub invalid_intervals:u64,
+}
+thread_local!{static CLOCKS:Cell<Research035Clocks>=Cell::new(Research035Clocks::default());}
+#[derive(Clone,Copy)]pub enum Research035Phase {Evaluation,Observation,Identity,Reestablishment,Envelope}
+pub struct Research035Clock {start:std::time::Instant,phase:Research035Phase,evaluation_before:u64}
+pub fn research035_clock(phase:Research035Phase)->Research035Clock{
+ Research035Clock{start:std::time::Instant::now(),phase,evaluation_before:CLOCKS.with(|c|c.get().evaluation_ns)}
+}
+pub fn research035_clocks()->Research035Clocks{CLOCKS.with(Cell::get)}
+pub fn research035_reset_clocks(){CLOCKS.with(|c|c.set(Research035Clocks::default()));}
+fn nanos(d:std::time::Duration)->u64{d.as_nanos().min(u64::MAX as u128)as u64}
+impl Drop for Research035Clock {fn drop(&mut self){
+ let elapsed=nanos(self.start.elapsed());CLOCKS.with(|cell|{let mut c=cell.get();match self.phase{
+  Research035Phase::Evaluation=>c.evaluation_ns+=elapsed,
+  Research035Phase::Observation=>c.observation_ns+=elapsed,
+  Research035Phase::Identity=>c.identity_ns+=elapsed,
+  Research035Phase::Reestablishment=>c.reestablishment_ns+=elapsed,
+  Research035Phase::Envelope=>{
+   let nested=c.evaluation_ns.checked_sub(self.evaluation_before);
+   if let Some(exclusive)=nested.and_then(|n|elapsed.checked_sub(n)){c.observation_ns+=exclusive;}else{c.invalid_intervals+=1;}
+  }
+ };cell.set(c);});
+}}
+pub fn research035_child_observation(total:std::time::Duration,logical:std::time::Duration){
+ CLOCKS.with(|cell|{let mut c=cell.get();if let Some(output)=total.checked_sub(logical){c.observation_ns+=nanos(output);}else{c.invalid_intervals+=1;}cell.set(c);});
+}
