+// PRIVATE EXPERIMENT INSTRUMENTATION. Not an official runtime/API capability.
+pub(super) fn experiment_note(kind:&str,rows:usize,unchanged_rows:usize) {
+    use std::io::Write;
+    if let Ok(path)=std::env::var("BEHAVIOR_015_WORK_LOG") {
+        if let Ok(mut file)=std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _=writeln!(file,"{}",json!({"kind":kind,"rows":rows,"unchanged_rows":unchanged_rows}));
+        }
+    }
+}
+
+#[cfg(not(test))]
+fn experiment_full_child<B:Backend>(store:&Store<B>,module:&Module,parent:&StateRef,record:&TransitionRecord)->R<Result<(),Vec<String>>> {
+    let mut values=BTreeMap::new();
+    for entity in module.entities().keys() {
+        for k in store.backend.keys_at(entity,parent.position).map_err(backend_err)? {
+            let v=store.backend.version_at(&k,parent.position).map_err(backend_err)?.ok_or_else(||invalid("reference member missing"))?;
+            if v.key()!=k {return Err(invalid("reference wrong typed key"));}
+            values.insert(k,v.value);
+        }
+    }
+    let changed:BTreeSet<_>=record.new_versions.iter().chain(&record.created).map(EntityVersion::key).collect();
+    for v in record.new_versions.iter().chain(&record.created) {values.insert(v.key(),v.value.clone());}
+    let mut incoming:BTreeMap<EntityKey,Vec<RefEdge>>=BTreeMap::new();
+    for (k,v) in &values {
+        for (field,target) in references_of(module,&k.entity,v) {
+            incoming.entry(target).or_default().push(RefEdge{entity:k.entity.clone(),id:k.id.clone(),field});
+        }
+    }
+    for edges in incoming.values_mut(){edges.sort();edges.dedup();}
+    let rows=values.iter().map(|(k,v)|((k.entity.clone(),k.id.clone()),v.clone())).collect();
+    experiment_note("child",values.len(),values.len().saturating_sub(changed.len()));
+    let facts=SeedFacts{keys:values.keys().cloned().collect(),incoming,values};
+    Ok(behavior_core::eval::check_behavior_snapshot(module,&rows,&facts))
+}
